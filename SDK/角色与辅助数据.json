    {
      "id": "dordoni",
      "name": "多鲁多尼·亚历山卓戴尔·索卡奇欧",
      "status": "documented",
      "tags": [
        "防反",
        "派生"
      ],
      "details": [
        "普攻衔接 WJ 时可跳过防反前摇，直接飞踢。防反动作也可用虚弹（U）取消。"
      ],
      "sources": [
        "catalog",
        "lang"
      ]
    },
    {
      "id": "gaara",
      "name": "我爱罗",
      "status": "documented",
      "tags": [
        "平台",
        "防御",
        "派生"
      ],
      "details": [
        "可以格挡背后攻击。空中出招后可暂站在砂上，期间可缓慢移动。最多连续触发三次，使用下台阶输入可以提前解除。",
        "久不继续普攻也会保留当前段数。替身变为加瑠罗的守护。同名辅助会以砂盾保护己方。"
      ],
      "sources": [
        "catalog",
        "lang"
      ]
    },
    {
      "id": "gin",
      "name": "市丸·银",
      "status": "documented",
      "tags": [
        "派生",
        "防御"
      ],
      "details": [
        "WJ 第一段真命中时第二段会自动转向。SU 在 3.8.8.4 已取消破防。"
      ],
      "sources": [
        "catalog",
        "lang",
        "p4"
